# ============================================
# TechPulse — Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Required ──────────────────────────────────────

# Gemini API Key (for AI-powered summaries)
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI API Key (for TTS voice narration — gpt-4o-mini-tts, coral voice)
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# ── Optional ──────────────────────────────────────

# NewsAPI Key (optional — RSS feeds work without it)
NEWSAPI_KEY=

# Server port (default: 3001)
PORT=3001

# Frontend URL for CORS (default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Vercel Cron Secret (only needed in production)
CRON_SECRET=
