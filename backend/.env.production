# ============================================
# TechPulse — Production Environment (Vercel)
# ============================================
# Set these in Vercel Dashboard → Settings → Environment Variables
# Do NOT commit actual values to version control.

# ── Required ──────────────────────────────────────

# Gemini API Key (for AI-powered article summaries)
GEMINI_API_KEY=your-production-gemini-api-key

# Vercel Cron Secret (auto-set by Vercel, or generate your own)
# Used to authenticate cron job requests to /api/cron
CRON_SECRET=your-cron-secret-here

# ── Optional ──────────────────────────────────────

# NewsAPI Key (optional — RSS feeds work without it)
NEWSAPI_KEY=

# Frontend URL (for CORS in production)
FRONTEND_URL=https://your-app-name.vercel.app

# Node environment
NODE_ENV=production

# TTS Provider: "browser" (handled client-side, no server cost)
TTS_PROVIDER=browser
